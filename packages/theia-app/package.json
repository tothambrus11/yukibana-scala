{
  "name": "@yukibana/theia-app",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only Theia workbench hosting the Scala WebAssembly toolchain",
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/output": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/workspace": "1.75.0",
    "@yukibana/theia-scala": "file:../theia-scala",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "theia build --mode development",
    "start": "theia start --port 3000 --hostname 0.0.0.0"
  },
  "theia": {
    "target": "browser-only",
    "frontend": {
      "config": {
        "applicationName": "Yukibana",
        "defaultTheme": {
          "light": "light",
          "dark": "dark"
        },
        "preferences": {
          "files.enableTrash": false,
          "editor.minimap.enabled": false,
          "security.workspace.trust.enabled": false,
          "files.autoSave": "off",
          "workbench.colorTheme": "dark",
          "yukibana.outputTarget": "js"
        }
      }
    }
  }
}
