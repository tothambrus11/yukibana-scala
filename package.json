{
  "name": "yukibana",
  "version": "0.1.0",
  "private": true,
  "description": "A fully client-side Scala IDE for the browser",
  "workspaces": [
    "packages/theia-scala",
    "packages/theia-app",
    "e2e"
  ],
  "scripts": {
    "fetch:toolchain": "scripts/fetch-toolchain.sh",
    "build:extension": "npm run build --workspace @yukibana/theia-scala",
    "build:ide": "npm run build:extension && npm run build --workspace @yukibana/theia-app",
    "build:cloudflare": "scripts/build-cloudflare.sh",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "start:playground": "node scripts/dev-server.mjs",
    "test:e2e": "node e2e/playground.mjs",
    "test:ide": "node e2e/ide.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
